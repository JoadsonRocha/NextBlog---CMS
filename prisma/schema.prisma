// NextBlog CMS - Prisma Schema
// Suporta PostgreSQL, SQLite, MySQL e CockroachDB

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  EDITOR
  VISITOR
}

enum PostStatus {
  PUBLISHED
  DRAFT
  SCHEDULED
}

enum CommentStatus {
  APPROVED
  PENDING
  SPAM
  TRASH
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  role      UserRole  @default(EDITOR)
  avatar    String?
  bio       String?
  status    String    @default("active")
  posts     Post[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("users")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#3b82f6")
  posts       Post[]
  createdAt   DateTime @default(now())

  @@map("categories")
}

model Post {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  excerpt       String?
  featuredImage String?
  status        PostStatus     @default(DRAFT)
  readingTime   String         @default("3 min")
  views         Int            @default(0)
  tags          String[]
  
  // Relacionamentos
  authorId      String
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments      Comment[]

  // Estrutura modular de blocos Notion-style (armazenados como JSON relacional)
  blocks        Json           @default("[]")

  // Metadados de SEO integrados
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean      @default(false)

  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([slug])
  @@index([status])
  @@map("posts")
}

model Page {
  id              String       @id @default(cuid())
  slug            String       @unique
  title           String
  description     String?
  template        String       @default("default")
  status          String       @default("published")
  isHomePage      Boolean      @default(false)
  orderIndex      Int          @default(0)

  // Blocos modulares da página
  blocks          Json         @default("[]")

  // SEO
  metaTitle       String?
  metaDescription String?
  ogImage         String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([slug])
  @@map("pages")
}

model ReusableBlock {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("content")
  description String?
  blockData   Json
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reusable_blocks")
}

model Comment {
  id          String        @id @default(cuid())
  postId      String
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String
  authorAvatar String?
  content     String
  status      CommentStatus @default(PENDING)
  response    String?
  createdAt   DateTime      @default(now())

  @@index([postId])
  @@map("comments")
}

model MediaItem {
  id         String    @id @default(cuid())
  name       String
  url        String
  type       MediaType @default(IMAGE)
  size       String?
  dimensions String?
  mimeType   String?
  altText    String?
  createdAt  DateTime  @default(now())

  @@map("media_items")
}

model PluginSetting {
  id          String   @id @default(cuid())
  pluginSlug  String   @unique
  isActive    Boolean  @default(true)
  configJson  Json?
  updatedAt   DateTime @updatedAt

  @@map("plugin_settings")
}

model GlobalConfig {
  id               String   @id @default("global")
  siteName         String   @default("NextBlog CMS")
  siteDescription  String?
  siteLogo         String?
  primaryColor     String   @default("#2563eb")
  fontFamily       String   @default("Inter")
  allowComments    Boolean  @default(true)
  databaseProvider String   @default("postgresql")
  updatedAt        DateTime @updatedAt

  @@map("global_configs")
}
