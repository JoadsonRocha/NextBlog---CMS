# GROQ_API_KEY: Chave de API da Groq para geração ultra-rápida de conteúdo com Llama 3.3 70B
# Obtenha sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY="gsk_sua_chave_groq_aqui"

# DATABASE_URL: Conexão com o banco PostgreSQL / Supabase / Neon
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nextblog_db?schema=public"

# APP_URL: URL de produção ou localhost
APP_URL="https://nextblog-cms.vercel.app"
